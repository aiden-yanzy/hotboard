# ============================================================
# 热榜平台 统一配置（复制成 .env 后按环境修改；.env 不进版本库）
#
#   部署（推荐）：只需要 docker-compose.yml + 这个 .env 两个文件
#       cp .env.example .env && vi .env      # 改数据目录/密码/站点信息
#       docker compose up -d
#
#   本机开发：从源码构建
#       docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build
# ============================================================

# ---------- ① 镜像（GHCR 上由 GitHub Actions 构建，amd64 + arm64 双架构） ----------
# 生产建议固定版本，别用 latest（否则每次 pull 都可能换版本）
#   查版本：https://github.com/aiden-yanzy/hotboard/pkgs/container/hotboard-web
HOTBOARD_REGISTRY=ghcr.io/aiden-yanzy
HOTBOARD_TAG=latest

# ---------- ② 对外端口（宿主映射） ----------
HOTBOARD_WEB_PORT=6600     # 前端（Astro SSR，对外唯一入口）
HOTBOARD_API_PORT=6700     # 聚合接口（web 容器已反代 /api，这里只供本机调试）
HOTBOARD_DB_PORT=5433      # Postgres（默认只绑 127.0.0.1）

# ---------- ③ 数据持久化目录（**云上改成 /data/hotboard 之类**） ----------
HOTBOARD_DATA_DIR=/data/hotboard

# ---------- ④ 数据库（首次启动自动建库建表；采集器首轮自动建表灌源） ----------
POSTGRES_USER=hotboard
POSTGRES_DB=hotboard
POSTGRES_PASSWORD=change-me-please

# ---------- ⑤ 时区（全项目统一 +8 北京） ----------
TZ=Asia/Shanghai

# ---------- ⑥ 采集器运行方式 ----------
#   云端：--loop --interval 1800 → 容器常驻，每 30 分钟一轮（**首轮自动初始化库**）
#   本机：留空 → 容器空闲待命，由外部定时任务 docker exec 触发
COLLECT_CMD=--loop --interval 1800
COLLECT_INTERVAL_SEC=1800

# ---------- ⑦ 采集引擎 ----------
#   源已全部自研化（custom 适配器），两个外部引擎停用：base_url 留空 = 整批跳过
ENGINE_DAILYHOT_URL=
ENGINE_NEWSNOW_URL=
# 聚合接口展示哪些引擎的源（逗号分隔）；只保留自研适配器
ENGINE_WHITELIST=custom

# ---------- ⑧ 对外访问地址（自检/文档用，不参与构建） ----------
HOTBOARD_PUBLIC_BASE=http://localhost

# ---------- ⑨ 站点个性化内容（留空 = 对应模块不渲染）----------
#   这些值只在**服务端**生效（SSR 时读 process.env，经 props 传给前端）。
#   仓库里的 site.ts 保持占位符，线上靠这里注入 → 代码干净、部署个性化。
#   ⚠️ 改这些值**不需要重新构建镜像**，改完 restart 容器即可：
#       docker compose up -d --force-recreate web

SITE_URL=https://your-domain.com        # canonical / sitemap / og 用
SITE_NAME=                              # 留空用默认名

# 备案（中国大陆必须）
SITE_ICP_TEXT=京ICP备XXXXXXXX号-1
SITE_ICP_URL=https://beian.miit.gov.cn/
SITE_POLICE_TEXT=京公网安备XXXXXXXXXXXXXX号
SITE_POLICE_URL=https://beian.mps.gov.cn/#/query/webSearch?code=XXXXXXXXXXXXXX

# 广告位（URL 必填，img/text 二选一；组件固定渲染「广告」角标，符合广告法要求）
SITE_AD_URL=
SITE_AD_IMG=/ad/your-300x250.jpg
SITE_AD_ALT=
SITE_AD_TEXT=

# 友情链接：名称|url，多个用分号分隔
SITE_LINKS=名称A|https://a.example.com;名称B|https://b.example.com
