---
import Base from "../layouts/Base.astro";
---

<Base title="页面不存在" description="你访问的榜单不存在或已下线。">
  <div style="text-align:center;padding:80px 20px">
    <h1 style="font-size:48px;margin:0;color:#ff5722">404</h1>
    <p class="sub" style="margin-top:12px">这个榜单不存在，可能已经下线</p>
    <p style="margin-top:24px">
      <a href="/" style="color:#ff5722">← 回到全部榜单</a>
    </p>
  </div>
</Base>
